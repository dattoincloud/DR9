<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="default.asp" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="App_Data" />
          <add segment="App_Data" />
          <remove segment="includes" />
          <add segment="includes" />
          <remove segment="scripts" />
          <add segment="scripts" />
        </hiddenSegments>
        <fileExtensions>
          <remove fileExtension=".mdb" />
          <add fileExtension=".mdb" allowed="false" />
          <remove fileExtension=".ldb" />
          <add fileExtension=".ldb" allowed="false" />
          <remove fileExtension=".accdb" />
          <add fileExtension=".accdb" allowed="false" />
          <remove fileExtension=".laccdb" />
          <add fileExtension=".laccdb" allowed="false" />
          <remove fileExtension=".mdw" />
          <add fileExtension=".mdw" allowed="false" />
          <remove fileExtension=".mde" />
          <add fileExtension=".mde" allowed="false" />
          <remove fileExtension=".accde" />
          <add fileExtension=".accde" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
